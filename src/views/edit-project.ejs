<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <form action="/edit-project/<%= projectDetails.project_id %>" method="POST">

            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" value="<%= projectDetails.title %>" maxlength="150"
                    required />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" rows="5" maxlength="500"
                    required><%= projectDetails.description %></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" value="<%= projectDetails.location %>" maxlength="255"
                    required />
            </div>

            <div class="form-group">
                <label for="organization_id">Organization</label>
                <select id="organization_id" name="organization_id" required>
                    <% organizations.forEach(org=> { %>
                        <option value="<%= org.organization_id %>"
                            <%=projectDetails.organization_id===org.organization_id ? 'selected' : '' %>
                            >
                            <%= org.name %>
                        </option>
                        <% }); %>
                </select>
            </div>

            <div class="form-group">
                <label for="date">Date</label>
                <input type="date" id="date" name="date"
                    value="<%= projectDetails.date ? projectDetails.date.toISOString().split('T')[0] : '' %>"
                    required />
            </div>

            <div class="form-actions">
                <button type="submit">Update Project</button>
                <a href="/project/<%= projectDetails.project_id %>" class="btn-cancel">Cancel</a>
            </div>

        </form>
    </main>

    <%- include('partials/footer') %>