<%- include('partials/header') %>
    <main>
        <div class="container">

            <h1>
                <%= title %>
            </h1>

            <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">
            <h2>
                <%= organizationDetails.name %>
            </h2>

            <p>Description: <%= organizationDetails.description %>
            </p>

            <h3>Service Projects</h3>
            <ul class="organizations-list">
                <% projects.forEach(project=> { %>
                    <li class="project-card"><a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </li>
                    <% }); %>
            </ul>
        </div>
    </main>
    <%- include('partials/footer') %>