<%- include('partials/header') %>
	<main>
		<div class="container">

			<h1>
				<%= title %>
			</h1>
			<!-- Action Buttons -->
			<% if (user && user.role_name=='admin' ) { %>
				<div class="project-actions"><a href="/edit-organization/<%= organizationDetails.organization_id %>"
						class="btn btn-primary">Edit
						Organization</a></div>
				<% } %>

					<img src="/images/<%= organizationDetails.logo_filename %>"
						alt="<%= organizationDetails.name %> logo">
					<div>
						<h2>
							<%= organizationDetails.name %>
						</h2>
						<p>
							<%= organizationDetails.description %>
						</p>
					</div>

					<h3>Service Projects</h3>
					<ul class="organizations-list">
						<% projects.forEach(project=> { %>
							<li class="project-card">
								<a href="/project/<%= project.project_id %>">
									<%= project.title %>
								</a>
							</li>
							<% }); %>
					</ul>
		</div>
	</main>
	<%- include('partials/footer') %>