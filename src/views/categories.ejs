<%- include('partials/header') %>
    <main>
        <div class="container">
            <h1>
                <%= title %>
            </h1>
            <!-- Action Buttons -->
            <div class="actions"><a href="/new-category" class="btn btn-primary">Add a new category</a></div>
            <h2>Service Projects Categories</h2>
            <ul class="categories-list">

                <% categories.forEach(category=> { %>
                    <li class="project-card">
                        <h3><a href="/category/<%= category.id %>">
                                <%= category.name %>
                            </a>
                        </h3>
                    </li>
                    <% }); %>
            </ul>
        </div>
    </main>
    <%- include('partials/footer') %>
