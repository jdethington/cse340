<%- include('partials/header') %>
  <main>
    <div class="container">

      <h1>
        <%= title %>
      </h1>
      <!-- Action Buttons -->
      <% if (user && user.role_name=='admin' ) { %>
        <div class="actions"><a href="/new-category" class="btn btn-primary">Add a new category</a></div>
        <% } %>

          <h2>Service Projects Categories</h2>

          <ul class="categories-list">
            <% categories.forEach(category=> { %>
              <a href="/category/<%= category.id %>">
                <li class="category-card">
                  <h3>
                    <%= category.name %>
                  </h3>
                </li>
              </a>
              <% }); %>
          </ul>
    </div>
  </main>
  <%- include('partials/footer') %>
