<%- include('partials/header') %>
	<main>
		<div class="container">

			<h1>
				<%= title %>
			</h1>
			<!-- Action Buttons -->
			<!-- // ======================================================================== -->
			<% if (user && user.role_name=='admin' ) { %>
				<div class="actions"><a href="/edit-category/<%= category.category_id %>" class="btn btn-primary">Edit
						category</a></div>
				<% } %>
					<!-- // ======================================================================== -->

					<div>
						<h2>
							<%= category.name %>
						</h2>
						<p>
							<%= category.description %>
						</p>
					</div>

					<ul class="categories-list">
						<% projects.forEach(project=> { %>
							<a href="/project/<%= project.project_id %>">
								<li class="project-card">
									<h3>
										<%= project.title %>
									</h3>
									<p>
										<%= project.date_long %>
									</p>
								</li>
							</a>
							<% }); %>
					</ul>

		</div>
	</main>
	<%- include('partials/footer') %>