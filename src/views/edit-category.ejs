<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <form action="/edit-category/<%= category.category_id %>" method="POST" class="edit-form">

            <div class="form-group">
                <label for="name">Category Name</label>
                <input type="text" id="name" name="name" value="<%= category.name %>" maxlength="150" required />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" rows="5" maxlength="500"
                    required><%= category.description || '' %></textarea>
            </div>


            <div class="form-actions">
                <button type="submit">Update Category</button>
                <a href="/category/<%= category.category_id %>" class="btn-cancel">Cancel</a>
            </div>

        </form>
    </main>

    <%- include('partials/footer') %>