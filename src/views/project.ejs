<%- include('partials/header') %>
  <main>
    <div class="container">

      <h1>
        <%= title %>
      </h1>
      <!-- Action Buttons -->
      <div class="project-actions"><a href="/edit-project/<%= project.project_id %>" class="btn btn-primary">Update
          Project</a>
        <a href="/assign-categories/<%= project.project_id %>" class="btn btn-secondary">Edit Categories</a>
      </div>
      <h2>
        <%= project.title %>
      </h2>

      <p><strong>Description: </strong>
        <%= project.description %>
      </p>
      <p><strong>Date:</strong>
        <%= project.date_long %>
      </p>
      <p><strong>Location:</strong>
        <%= project.location %>
      </p>
      <p><strong>Partner Organization: </strong>
        <a href="/organization/<%= project.organization_id  %>" class="btn btn-small">
          <%= project.organization_name %>
        </a>
      </p>


      <h3>Categories</h3>
      <ul class="categories-list">
        <% categories.forEach(category=> { %>
          <a href="/category/<%= category.category_id %>">
            <li class="category-card">
              <h3>
                <%= category.name %>
              </h3>
            </li>
          </a>
          <% }); %>
      </ul>

    </div>
  </main>
  <%- include('partials/footer') %>