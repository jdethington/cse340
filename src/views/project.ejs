<%- include('partials/header') %>
  <main>
    <div class="container">

      <h1>
        <%= title %>
      </h1>
      <!-- Action Buttons -->
      <div class="project-actions"><a href="/edit-project/<%= project.project_id %>" class="btn btn-primary">Update
          Project</a>
        <a href="/assign-categories/<%= project.project_id %>" class="btn btn-secondary">Edit Categories</a>
        <h2>
      </div>
      <%= project.title %>
        </h2>


        <p><strong>Description: </strong>
          <%= project.description %>
        </p>

        <h3>Categories</h3>
        <ul class="categories-list">
          <% categories.forEach(category=> { %>
            <li class="project-card">
              <a href="/category/<%= category.category_id %>">
                <%= category.name %>
              </a>
            </li>
            <% }); %>
        </ul>

        <p><strong>Date:</strong>
          <%= project.date_short %>
        </p>
        <p><strong>Location:</strong>
          <%= project.location %>
        </p>
        <p><strong>Partner Organization: </strong>
          <a href="/organization/<%= project.organization_id  %>">
            <%= project.organization_name %>
          </a>
        </p>

    </div>
  </main>
  <%- include('partials/footer') %>